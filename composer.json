{
  "name": "s3rgiosan/divi-migration",
  "description": "Convert Divi Builder content to blocks.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Sérgio Santos",
      "homepage": "https://s3rgiosan.dev"
    }
  ],
  "autoload": {
    "psr-4": {
      "S3S\\WP\\DiviMigration\\": "includes/"
    }
  },
  "require": {
    "php": "^8.2",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "pixelalbatross/coding-standards": "dev-main",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "scripts": {
    "lint": "phpcs .",
    "lint-fix": "phpcbf .",
    "test": "phpunit"
  },
  "extra": {
    "installer-name": "divi-migration"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    }
  }
}
